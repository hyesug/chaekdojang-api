# .env.example - 이 파일을 복사해서 .env로 만들고 실제 값을 채우세요.
# cp .env.example .env

# 데이터베이스
DB_USERNAME=chaekdojang
DB_PASSWORD=your-strong-password

# 프로덕션 전용: RDS 엔드포인트 (docker-compose.prod.yml에서 사용)
DB_HOST=your-rds-endpoint.rds.amazonaws.com

# JWT
# 최소 32자 이상의 랜덤 문자열을 사용하세요. 예: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-must-be-at-least-32-characters-long

# OAuth 로그인
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 책 검색 API
KAKAO_API_KEY=
GOOGLE_API_KEY=

# 알림 메일 SMTP
# 운영 compose가 아래 Gmail 계정을 발신자와 관리자 수신자로 사용합니다.
MAIL_USERNAME=
MAIL_PASSWORD=

# 관리자 사용자 활동 추적 (자동 제재 없이 참고 경고만 생성)
USER_ACTIVITY_LOG_RETENTION_DAYS=90
USER_ACTIVITY_PUBLIC_READ_ALERT_WINDOW_MINUTES=5
USER_ACTIVITY_PUBLIC_READ_ALERT_THRESHOLD=120

# 추후 기능용 외부 API
DEEPL_API_KEY=
TOSS_SECRET_KEY=

# AI 독서카드/도장 코멘트
OPENAI_API_KEY=
OPENAI_REVIEW_SUMMARY_MODEL=
# 도장 코멘트만 다른 키/모델로 분리해야 할 때만 사용하세요.
# LLM_API_KEY=
# LLM_MODEL=
FEEDBACK_MIN_CHARS=150
FEEDBACK_MAX_CHARS=6000
FEEDBACK_DAILY_LIMIT_MEMBER=0

# 앱 URL
FRONTEND_URL=https://your-domain.vercel.app
BACKEND_URL=https://your-api-domain.com

# Docker Hub (CI/CD 또는 프로덕션 compose에서 사용)
DOCKERHUB_USERNAME=your-dockerhub-username
